# ---- Server ----
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
# If the frontend is hosted on Vercel, add that origin (comma-separated) so CORS works,
# e.g. CLIENT_URL=http://localhost:5173,https://kintech-crm.vercel.app
DOMAIN=crm.kintechagency.com

# Database (MongoDB) — e.g. local mongodb://localhost:27017, an Atlas SRV URI,
# or MongoDB on a VPS: mongodb://user:pass@123.45.67.89:27017/kintech_crm?authSource=admin
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=kintech_crm

# Redis
REDIS_URL=redis://localhost:6379

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# 2FA
TOTP_ISSUER=KinTech Agency

# File storage (S3-compatible or local). Set STORAGE_DRIVER=s3 to use S3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# Public base URL where stored files are served from (local driver uses /uploads)
PUBLIC_STORAGE_URL=http://localhost:5000/uploads

# SMTP email (optional in dev). Leave empty to disable sending (logs instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="KinTech CRM <no-reply@kintechagency.com>"

# SMS / WhatsApp (optional) — used only if provider keys present.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Rate limits
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_LEAD_WINDOW_MIN=10
RATE_LIMIT_LEAD_MAX=15

# Validation engine
VALIDATION_URL_TIMEOUT_MS=8000
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
LEAD_FOLLOWUP_DAYS=21
# Trust score floor below which approval requires manual touch
LOW_TRUST_THRESHOLD=40
# Fraud velocity limit: max submissions per agent in a window before flagging
FRAUD_VELOCITY_MAX=10
FRAUD_VELOCITY_WINDOW_MIN=10

# Commission defaults (used only for seeding; runtime values live in DB)
DEFAULT_PER_LEAD_RATE=7
DEFAULT_SUPER_LEAD_BONUS=200
WITHDRAWAL_FIRST_LIMIT=100
WITHDRAWAL_SUBSEQUENT_LIMIT=50

# ---- Frontend (Vercel: set these in the Vercel project; a fresh build reads them) ----
# The API origin the browser should talk to. Omit (or default /api) to proxy via vercel.json.
# VITE_API_URL=https://crm.kintechagency.com/api

# Backup config (documented; run `./scripts/backup.sh` or cron)
BACKUP_DIR=./backups