{
  "name": "kintech-crm",
  "version": "1.0.0",
  "private": true,
  "description": "KinTech Agency Lead Generation CRM — production-grade full-stack app",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "wipe-seed": "npm run wipe-seed -w server",
    "test": "npm run test -w server",
    "worker": "npm run worker -w server",
    "backup": "bash scripts/backup.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  }
}